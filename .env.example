# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=

# Compose sets FILE_STORAGE_ROOT to its volume target.
FILE_STORAGE_ROOT=/data/uploads
FILE_MAX_SIZE=10485760
FILE_USER_QUOTA=524288000
FILE_GLOBAL_QUOTA=4294967296
FILE_UPLOAD_CONCURRENCY=4
FILE_VALIDATION_CONCURRENCY=2
FILE_UPLOAD_READ_TIMEOUT_SECONDS=60
FILE_VALIDATION_TIMEOUT_SECONDS=10
FILE_VALIDATION_MEMORY_BYTES=536870912
FILE_DISK_HEADROOM_BYTES=104857600

# Reserved for the postponed Google sign-in feature.
CLIENT_ID=
CLIENT_SECRET=
